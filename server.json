{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Bytestay/specwise-mcp",
  "description": "OpenAPI and JSON Schema validation and OpenAPI breaking-change diffs for AI agents.",
  "repository": {
    "url": "https://github.com/bytestay/specwise-mcp",
    "source": "github",
    "id": "1445856363"
  },
  "websiteUrl": "https://specwise.bytestay.pt/integration.html#mcp-server",
  "version": "0.2.8",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "bytestay-specwise-mcp",
      "version": "0.2.8",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RAPIDAPI_KEY",
          "description": "Your RapidAPI key",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "API_MARKET_KEY",
          "description": "Your api.market key, used when RAPIDAPI_KEY is not set",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "BYTESTAY_MARKETPLACE",
          "description": "rapidapi or apimarket, when both keys are set (the old name HFL_MARKETPLACE still works)",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "choices": [
            "rapidapi",
            "apimarket"
          ]
        }
      ]
    }
  ]
}
